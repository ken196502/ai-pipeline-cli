{
  "version": "1",
  "extends": "preset:apple-clean",
  "theme": {
    "bg": "#101014",
    "ink2": "#1A1A1F",
    "accent": "#F5F5F7",
    "palette": {
      "bone": "#F5F5F7",
      "ash": "#A1A1A6",
      "graphite": "#6E6E73",
      "ember": "#D6D6DB",
      "blood": "#FF453A",
      "acid": "#30D158"
    },
    "font": "\"SF Pro Display\", \"Helvetica Neue\", Inter, system-ui, sans-serif"
  },
  "timing": {
    "titleIn": 0.55,
    "titleHold": 1.1,
    "titleOut": 0.55,
    "titleSafePad": 0.1,
    "lineGap": 0.12,
    "shotGap": 0.18,
    "clipTail": 0.5,
    "shotDur": 4.2,
    "shotTrans": 0.8,
    "clipTrans": 1.0
  },
  "components": {
    "flash": {
      "interval": 0.24,
      "punch": 0.02,
      "shutter": 0.18,
      "border": "#F5F5F7",
      "pool": "tag:candidate",
      "badge": false
    },
    "finalShowcase": {
      "tag": "FINAL AI VIDEO SHOWCASE",
      "audio": "source",
      "asset": "final-ai-video",
      "fit": "contain"
    },
    "subtitleBanner": { "enabled": false }
  },
  "camera": { "mode": "static", "zoomRange": [1.0, 1.0], "rollMax": 0, "driftPx": 0 },
  "transitions": {
    "clip": { "mode": "fixed", "pool": ["dreamyZoom"], "seed": 3, "params": {} },
    "shot": { "type": "conveyor" },
    "visualSwap": { "type": "slide-fade" }
  },
  "post": {
    "renderer": "webgl",
    "halation": 0,
    "halationTint": "#FFFFFF",
    "grain": 0.015,
    "chromaticAberration": 0,
    "vignette": 0.18,
    "contrast": 1.02
  },
  "overrides": {}
}
